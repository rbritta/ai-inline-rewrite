<?xml version="1.0" encoding="utf-8"?>
<!--
  The release build: one self-contained AiInlineRewrite.exe for 64-bit Windows, no .NET install needed.
    dotnet publish src/AiInlineRewrite -p:PublishProfile=win-x64
-->
<Project>
    <PropertyGroup>
        <Configuration>Release</Configuration>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <SelfContained>true</SelfContained>
        <PublishSingleFile>true</PublishSingleFile>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
        <DebugType>none</DebugType>
        <PublishDir>..\..\artifacts\publish\win-x64\</PublishDir>
    </PropertyGroup>
</Project>
