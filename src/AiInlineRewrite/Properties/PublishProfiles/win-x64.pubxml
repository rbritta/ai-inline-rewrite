<?xml version="1.0" encoding="utf-8"?>
<!--
  The release build: a self-contained folder for 64-bit Windows (AiInlineRewrite.exe with the .NET runtime, WPF and the
  built-in engine's llama.cpp libraries beside it), no .NET install needed. The zip and the Microsoft Store package are
  made from it. Not a single file: on .NET 11, WPF's DirectWriteForwarder.dll does not load from inside the bundle
  (BadImageFormatException at start), and llama.cpp looks for its libraries in runtimes\ next to the exe.
    dotnet publish src/AiInlineRewrite -p:PublishProfile=win-x64
-->
<Project>
    <PropertyGroup>
        <Configuration>Release</Configuration>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <SelfContained>true</SelfContained>
        <PublishSingleFile>false</PublishSingleFile>
        <DebugType>none</DebugType>
        <PublishDir>..\..\artifacts\publish\win-x64\</PublishDir>
    </PropertyGroup>
</Project>
