<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net9.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <UseWindowsForms>true</UseWindowsForms>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>Resources\app.ico</ApplicationIcon>
        <AssemblyName>AiInlineRewrite</AssemblyName>
        <RootNamespace>AiInlineRewrite</RootNamespace>
        <!-- The one place the version lives; VersionTests checks the CHANGELOG agrees. -->
        <Version>0.1.0</Version>
        <Product>AI Inline Rewrite</Product>
        <Description>Type in your language, get it rewritten right where you type.</Description>
        <Company>rbritta</Company>
        <Copyright>Copyright (c) 2026 rbritta</Copyright>
        <!-- WPF reads DPI awareness from app.manifest; silence the WinForms-only nag. -->
        <NoWarn>$(NoWarn);WFO0003</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <!-- WinForms is here only for the tray icon; keep its names (Application, Clipboard...) out of the WPF code. -->
        <Using Remove="System.Windows.Forms" />
        <Using Remove="System.Drawing" />
    </ItemGroup>

    <ItemGroup>
        <!-- The tray needs real .ico files (generated by tools/make_logo.py). -->
        <EmbeddedResource Include="Resources\app.ico" LogicalName="AiInlineRewrite.app.ico" />
        <EmbeddedResource Include="Resources\tray-off.ico" LogicalName="AiInlineRewrite.tray-off.ico" />
    </ItemGroup>

    <ItemGroup>
        <!-- The official Anthropic SDK, for the Claude engine. -->
        <PackageReference Include="Anthropic" Version="13.12.0" />
    </ItemGroup>

</Project>
